# CTSV User Credentials & Tokens
# Obtain these by running `python scripts/get_credentials.py` or from browser devtools
USERNAME=your_student_id
X-STUDENT-PORTAL-TOKEN=your_student_portal_token
X-ACCESS-TOKEN=your_access_token
TOKENCODE=your_tokencode
AUTHORIZATION=your_bearer_or_basic_authorization_header

# Application Settings
DEBUG=True
PORT=8000
HOST=127.0.0.1
DB_PATH=data/pdscores.db
CACHE_TTL_MINUTES=30

